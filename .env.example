# Local development only. Generate a unique random secret; set the production value in the host dashboard.
SECRET_KEY=replace-with-a-long-random-secret
# Local SQLite by default. In production, set DATABASE_URL to your hosted PostgreSQL connection string.
DATABASE_URL=sqlite:///learning_assistant.db
COOKIE_SECURE=false
FLASK_DEBUG=false

# Choose one provider: groq (hosted), gemini, openai, or ollama.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback model; configure only after verifying access in Groq Console.
GROQ_FALLBACK_MODEL=
AI_TIMEOUT_SECONDS=60

# Optional legacy Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=

# Optional local Ollama settings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Optional OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional OCR model for scanned PDF pages (Groq vision-capable model)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OCR_TIMEOUT_SECONDS=90

# Optional: exact origin of a separately hosted React frontend (no trailing slash).
FRONTEND_ORIGIN=
# For cross-site frontend/backend hosting only: set COOKIE_SECURE=true and SESSION_COOKIE_SAMESITE=None.
SESSION_COOKIE_SAMESITE=Lax

# Email verification (required for password-based registration).
# Recommended for Render Free: use Nylas HTTPS API because outbound SMTP ports are blocked.
# Create a free Nylas-branded *.nylas.email domain in the Nylas dashboard.
BACKEND_PUBLIC_URL=https://learnmates.onrender.com
EMAIL_PROVIDER=nylas
NYLAS_API_KEY=
NYLAS_DOMAIN=
NYLAS_FROM_EMAIL=
NYLAS_API_BASE=https://api.us.nylas.com
# Destination for new student feedback notifications (optional if admin user emails are configured).
SUPPORT_EMAIL=
# SMTP fallback for hosts that permit outbound SMTP; Render Free does not permit ports 25/465/587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# Google OAuth (optional until configured in Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to the frontend-origin callback when using frontend/vercel.json proxy rewrites.
# Register this exact URI in Google Cloud Console, e.g. https://learnmeets.vercel.app/auth/google/callback
GOOGLE_REDIRECT_URI=
