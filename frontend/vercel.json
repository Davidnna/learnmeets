{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://learnmates.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://learnmates.onrender.com/auth/:path*" },
    { "source": "/health", "destination": "https://learnmates.onrender.com/health" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
